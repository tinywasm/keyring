graph TD
    subgraph "Consumer"
        APP[Application<br/>Updater / Deploy / CLI]
    end

    subgraph "tinywasm/keyring"
        KM[KeyManager]
        KR[Keyring<br/>service-scoped]
        API[Public API<br/>Setup, Get, Rotate, Set, Delete]
        PR[Provider<br/>SetProvider / GetProvider]
    end

    subgraph "External Library"
        ZK[zalando/go-keyring]
    end

    subgraph "OS Security Layer"
        subgraph "Windows"
            CM[Credential Manager]
        end
        subgraph "Linux"
            SS[Secret Service / DBus]
        end
        subgraph "macOS"
            KC[Keychain]
        end
    end

    APP --> API
    API --> KR
    API --> KM
    KM --> KR
    KR --> PR
    PR --> ZK
    ZK --> CM
    ZK --> SS
    ZK --> KC

    style KR fill:#e1f5ff
    style KM fill:#e1f5ff
    style PR fill:#e1f5ff
    style ZK fill:#ffe1e1
    style CM fill:#fff4e1
    style SS fill:#fff4e1
    style KC fill:#fff4e1